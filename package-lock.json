{
  "name": "archivum-monorepo",
  "version": "0.2.8",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "archivum-monorepo",
      "version": "0.2.8",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/archivum-core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/archivums": {
      "resolved": "packages/cli",
      "link": true
    },
    "packages/cli": {
      "name": "archivums",
      "version": "0.2.14",
      "license": "MIT",
      "bin": {
        "archivum": "bin/archivum.js"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "packages/core": {
      "name": "archivum-core",
      "version": "0.2.1",
      "license": "MIT",
      "engines": {
        "node": ">=22"
      }
    }
  }
}
